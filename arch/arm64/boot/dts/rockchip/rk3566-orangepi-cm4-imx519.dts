/dts-v1/;

#include "rk3566-orangepi-cm4.dtsi"

/ {
    imx519_reg: imx519-reg {
        compatible = "regulator-fixed";
        regulator-name = "imx519_reg";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
    };

    imx519_vdig: imx519-vdig {
        compatible = "regulator-fixed";
        regulator-name = "imx519_vdig";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
    };

    imx519_vddl: imx519-vddl {
        compatible = "regulator-fixed";
        regulator-name = "imx519_vddl";
        regulator-min-microvolt = <1200000>;
        regulator-max-microvolt = <1200000>;
    };

};

&csi2_dphy_hw {
    status = "okay";
};

&rkisp {
    status = "okay";
};

&rkisp_mmu {
    status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp0_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

&rkcif {
    status = "okay";
};

&rkcif_mmu {
    status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi_in: endpoint {
			remote-endpoint = <&mipi_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp0_vir0>;
		};
	};
};

&mipi_csi2 {
    status = "okay";

    ports {
        #address-cells = <1>;
        #size-cells = <0>;

        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_csi2_input: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&dphy0_out>;
                data-lanes = <1 2>;
            };
        };

        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_csi2_output: endpoint@0 {
                reg = <0>;
                remote-endpoint = <&cif_mipi_in>;
                data-lanes = <1 2>;
            };
        };
    };
};

&csi2_dphy0 {
	status = "okay";
	
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			
			dphy0_in: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&imx519_out>;
				data-lanes = <1 2>;
			};
		};
		
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			
			dphy0_out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&mipi_csi2_input>;
			};
		};
	};
};

&i2c1 {
    imx519: imx519@1a {
        compatible = "sony,imx519";
        reg = <0x1a>;
        status = "okay";

        clocks = <&cru CLK_CIF_OUT>;
        clock-names = "xvclk";

        VANA-supply = <&imx519_reg>;	/* 2.8v */
        VDIG-supply = <&imx519_vdig>;	/* 1.8v */
        VDDL-supply = <&imx519_vddl>;	/* 1.2v */

        lens-focus = <&ak7375>;

        rotation = <0>;
        orientation = <0>;

        reset-gpios = <&gpio2 RK_PC6 GPIO_ACTIVE_HIGH>;
        rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "IMX519";
		rockchip,camera-module-lens-name = "NA";

        port {
			imx519_out: endpoint {
				remote-endpoint = <&dphy0_in>;
                clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <493500000>;
			};
		};
    };

    ak7375: ak7375@0c {
        compatible = "asahi-kasei,ak7375";
        reg = <0x0c>;
        status = "okay";
        VANA-supply = <&imx519_reg>;	/* 2.8v */
    };
};
