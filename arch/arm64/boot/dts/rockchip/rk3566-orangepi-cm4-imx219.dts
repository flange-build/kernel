/dts-v1/;

#include "rk3566-orangepi-cm4.dtsi"

/ {
    imx219_vana: imx219-vana {
        compatible = "regulator-fixed";
        regulator-name = "imx219_vana";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
    };

    imx219_vdig: imx219-vdig {
        compatible = "regulator-fixed";
        regulator-name = "imx219_vdig";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <1800000>;
    };

    imx219_vddl: imx219-vddl {
        compatible = "regulator-fixed";
        regulator-name = "imx219_vddl";
        regulator-min-microvolt = <1200000>;
        regulator-max-microvolt = <1200000>;
    };

};

&csi2_dphy_hw {
    status = "okay";
};

&rkisp {
    status = "okay";
};

&rkisp_mmu {
    status = "okay";
};

&rkisp_vir0 {
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp0_vir0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

&rkcif {
    status = "okay";
};

&rkcif_mmu {
    status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";

	port {
		cif_mipi_in: endpoint {
			remote-endpoint = <&mipi_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";

	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp0_vir0>;
		};
	};
};

&mipi_csi2 {
    status = "okay";

    ports {
        #address-cells = <1>;
        #size-cells = <0>;

        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_csi2_input: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&dphy1_out>;
                data-lanes = <1 2>;
            };
        };

        port@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;

            mipi_csi2_output: endpoint@0 {
                reg = <0>;
                remote-endpoint = <&cif_mipi_in>;
                data-lanes = <1 2>;
            };
        };
    };
};

&csi2_dphy1 {
	status = "okay";
	
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
			
			dphy1_in: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&imx219_out>;
				data-lanes = <1 2>;
			};
		};
		
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			
			dphy1_out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&mipi_csi2_input>;
			};
		};
	};
};

&i2c1 {

    imx219: imx219@10 {
        compatible = "sony,imx219";
        reg = <0x10>;
        status = "okay";

        clocks = <&cru CLK_CIF_OUT>;
        clock-names = "xclk";

        VANA-supply = <&imx219_vana>;   /* 2.8v */
        VDIG-supply = <&imx219_vdig>;   /* 1.8v */
        VDDL-supply = <&imx219_vddl>;   /* 1.2v */

        rotation = <180>;
        orientation = <2>;

        reset-gpios = <&gpio2 RK_PC6 GPIO_ACTIVE_HIGH>;
        rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "imx219";
		rockchip,camera-module-lens-name = "NA";

        port {
			imx219_out: endpoint {
				remote-endpoint = <&dphy1_in>;
                clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				link-frequencies = /bits/ 64 <456000000>;
			};
		};
    };


};
